design.set_device_property("cfg","RECONFIG_EN","0","RU")


# ---------- GPIO ----------
# 24MHz 晶振: 专用 PLL 输入脚 (C5 = GPIOL_11_PLLIN2 -> EXT_CLK2)
design.create_pll_input_clock_gpio("clk24m")

# 复位按键 KEY0 (N2), 1.8V bank
design.create_input_gpio("rst_n")
# C P6: keys K1/K2
design.create_input_gpio("key_plus")
design.create_input_gpio("key_minus")

# 摄像头 PCLK (B8 = GPIOT_P_07_CLK4_P, 时钟能力脚)
design.create_input_clock_gpio("cmos_pclk")

# DVP 数据与控制 (3.3V)
design.create_input_gpio("cmos_d",7,0)
design.create_input_gpio("cmos_vsync")
design.create_input_gpio("cmos_href")

# SCCB 两线
design.create_output_gpio("cmos_sclk")
design.create_inout_gpio("cmos_sdat")
design.set_property("cmos_sdat","IN_PIN","cmos_sdat_in")
design.set_property("cmos_sdat","OUT_PIN","cmos_sdat_out")
design.set_property("cmos_sdat","OE_PIN","cmos_sdat_oe")

# 给 sensor 的主时钟 XCLK + 三个控制脚
design.create_output_gpio("cmos_xclk")
design.create_output_gpio("cmos_ctl1")
design.create_output_gpio("cmos_ctl2")
design.create_output_gpio("cmos_ctl3")

# 状态灯 (LED6/7 与 CMOS_D0/D1 复用, 只用 LED0..LED5)
design.create_output_gpio("led",5,0)

# UART 诊断输出 (板载 CH340N; E10 = GPIOT_P_16, bank 2B 1.8V)
design.create_output_gpio("fpga_txd")


# ---------- Properties ----------
# --- 3.3 V BANK (TL / BL / BR) ---
design.set_property("clk24m",    "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("cmos_sclk", "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("cmos_sdat", "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("cmos_xclk", "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("cmos_href", "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("cmos_d[0]", "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("cmos_d[1]", "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("cmos_d[2]", "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("cmos_d[3]", "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("cmos_d[4]", "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("cmos_d[5]", "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("cmos_d[6]", "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("cmos_d[7]", "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("cmos_ctl1", "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("cmos_ctl2", "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("led[0]",    "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("led[1]",    "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("led[2]",    "IO_STANDARD","3.3_V_LVCMOS")
design.set_property("led[3]",    "IO_STANDARD","3.3_V_LVCMOS")
